<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DalamudPackager" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MahjongHater.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="validation-libs/**/*.cs" />
    <EmbeddedResource Remove="validation-libs/**/*" />
    <None Remove="validation-libs/**/*" />
    <Compile Remove="MahjongHater.Tests/**/*.cs" />
    <Compile Remove="tools/Precompute/**/*.cs" />
    <EmbeddedResource Remove="MahjongHater.Tests/**/*" />
    <None Remove="MahjongHater.Tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)\Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)\FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ImGuiScene">
      <HintPath>$(DalamudLibPath)\ImGuiScene.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)\InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="MahjongHater.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Layout ships next to the dll (editable) and is embedded as the fallback. -->
    <None Update="resources/layouts/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="resources/layouts/emj.json" LogicalName="MahjongHater.resources.layouts.emj.json" />
    <!-- Deal-in rate tables (docs/research → tools/make_deal_in_rates.py); same ship/embed rule. -->
    <None Update="resources/policy/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="resources/policy/deal_in_rates.json" LogicalName="MahjongHater.resources.policy.deal_in_rates.json" />
    <!-- An offline lookup table ships the same way once tools/Precompute has produced one:
         resources/policy/precomputed_policy.json[.gz] is already covered by the glob above,
         and a packed simulation database goes in resources/policy/simulation_policy. -->
    <None Include="resources/policy/simulation_policy/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Learned models ship with the plugin, gzipped (37 MB each); LearnedModel.Load reads
         .json.gz directly, and a model in the config folder overrides the shipped one. -->
    <None Update="resources/models/*.json.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
